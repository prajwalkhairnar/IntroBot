# ===========================
# Backend Configuration
# ===========================

# Server
PORT=3001

# Personal Identity
NAME=YourName

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# LLM Model Parameters - Main Chat Model
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# LLM Model Parameters - Conversation Title Generation
GROQ_NAMING_TEMPERATURE=0.3
GROQ_NAMING_MAX_TOKENS=50

# ===========================
# Frontend Configuration (VITE_ prefix)
# ===========================

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Personal Information
VITE_INTRO_NAME=Hi, I'm YourName!
VITE_WORK_TITLE_1=Your primary work title here
VITE_WORK_TITLE_2=Your alternative work title here

# Social Links
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile/
VITE_GITHUB_URL=https://github.com/yourusername
VITE_EMAIL=your.email@example.com

# Export/Download Configuration
VITE_CV_FILENAME=Your_Name_CV.pdf
VITE_ASSISTANT_NAME=YourName

# Fallback support for API keys
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
